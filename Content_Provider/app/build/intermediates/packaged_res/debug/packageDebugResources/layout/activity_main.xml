<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bk2"
    tools:context=".MainActivity"
    android:padding="16dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Nguyễn Thị Hiếu\nmsv:22115053122114"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#D5064C"
        android:layout_marginBottom="32dp"
        android:layout_marginTop="24dp"
        android:gravity="center" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">


        <Button
            android:id="@+id/btnshowallcontact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin danh bạ"
            android:background="@drawable/radius_buttom"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:textSize="18sp"
            android:textColor="@android:color/white" />
        <Button
            android:id="@+id/btnaccesscalllog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nhật ký cuộc gọi"
            android:background="@drawable/radius_buttom"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:textSize="18sp"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnshowmessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin tin nhắn"
            android:background="@drawable/radius_buttom"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:textSize="18sp"
            android:textColor="@android:color/white" />
    </LinearLayout>
</LinearLayout>
